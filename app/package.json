{
  "name": "subpager-app",
  "version": "0.0.10",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start:staging": "APP_VARIANT=development expo start",
    "start:prod": "expo start",
    "run:staging:android": "APP_VARIANT=development expo run:android",
    "run:prod:android": "expo run:android",
    "run:staging:ios": "APP_VARIANT=development expo run:ios",
    "run:prod:ios": "expo run:ios",
    "eas:build:local": "eas build --platform android --profile preview --local",
    "eas:build:prod:preview:android": "APP_VARIANT=production eas build --platform android --profile preview",
    "eas:build": "eas build --platform android --profile production",
    "eas:submit": "eas submit --platform android --profile production",
    "eas:deploy": "eas build --platform android --profile production --auto-submit",
    "test": "bun test --isolate"
  },
  "dependencies": {
    "@expo/ui": "58.0.27",
    "@legendapp/list": "3.6.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tabler/icons-react-native": "^3.44.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.21",
    "firebase": "^12",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.4.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.80.0",
    "typescript": "~6.0.3"
  }
}
