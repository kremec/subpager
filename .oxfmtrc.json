{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": {
    "internalPattern": ["@/"],
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": [
          "react",
          "react/**",
          "react-native",
          "react-native/**"
        ],
        "modifiers": ["value"]
      },
      {
        "groupName": "expo",
        "elementNamePattern": ["expo", "expo-*", "expo-*/**"],
        "modifiers": ["value"]
      }
    ],
    "groups": [
      "type-import",
      "react",
      "expo",
      ["builtin", "external"],
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "unknown"
    ]
  }
}
