{
  "name": "subpager-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "bun -e 'import { initConfig } from \"./src/config\"; console.log(await initConfig())'",
    "start": "bun src/index.ts",
    "setup": "bun -e 'import { setup } from \"./scripts/tools\"; await setup()'",
    "setup:usb": "bun -e 'import { setup } from \"./scripts/tools\"; await setup(true)'",
    "doctor": "bun -e 'import { doctor } from \"./scripts/tools\"; await doctor()'",
    "calibrate": "bun -e 'import { calibrate } from \"./scripts/tools\"; await calibrate(Bun.argv[1], Bun.argv[2])'",
    "record": "bun -e 'import { record } from \"./scripts/tools\"; await record(Bun.argv[1], Bun.argv[2])'",
    "replay": "bun -e 'import { replay } from \"./scripts/tools\"; await replay(Bun.argv[1])'",
    "member:approve": "bun -e 'import { setMember } from \"./scripts/tools\"; await setMember(Bun.argv[1], true)'",
    "member:revoke": "bun -e 'import { setMember } from \"./scripts/tools\"; await setMember(Bun.argv[1], false)'",
    "member:list": "bun -e 'import { listMembers } from \"./scripts/tools\"; await listMembers()'",
    "ric:sync": "bun -e 'import { syncRicUnits } from \"./scripts/tools\"; await syncRicUnits(Bun.argv[1])'",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src scripts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start:sync": "SUBPAGER_NO_RADIO=1 bun src/index.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "~6.0.3"
  }
}
