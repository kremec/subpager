{
  "name": "subpager-app",
  "version": "0.0.2",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start:staging": "APP_VARIANT=development expo start",
    "start:prod": "expo start",
    "run:staging:android": "APP_VARIANT=development expo run:android",
    "run:prod:android": "expo run:android",
    "run:staging:ios": "APP_VARIANT=development expo run:ios",
    "run:prod:ios": "expo run:ios",
    "eas:build:local": "eas build --platform android --profile preview --local",
    "eas:build:prod:preview:android": "APP_VARIANT=production eas build --platform android --profile preview",
    "eas:build": "eas build --platform android --profile production",
    "eas:submit": "eas submit --platform android --profile production",
    "eas:deploy": "eas build --platform android --profile production --auto-submit",
    "lint": "oxlint src convex",
    "test": "bun test --isolate",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "tsc --noEmit",
    "convex:deploy": "convex deploy",
    "prepare": "git config --local include.path ../.githooks/.gitconfig"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@expo/ui": "~57.0.22",
    "@legendapp/list": "3.3.10",
    "@tabler/icons-react-native": "^3.44.0",
    "convex": "^1.46.0",
    "expo": "~57.0.27",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.4.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "convex-test": "^0.0.60",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "~6.0.3"
  }
}
