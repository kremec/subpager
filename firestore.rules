rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isApproved() {
      return request.auth != null
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.approved == true;
    }

    match /members/{uid} {
      allow get: if isOwner(uid);
    }

    match /messages/{messageId} {
      allow get, list: if isApproved();
    }

    match /ricUnits/{ric} {
      allow get, list: if isApproved();
    }

    match /devices/{uid} {
      allow get, delete: if isOwner(uid) && isApproved();
      allow create, update: if isOwner(uid) && isApproved()
        && request.resource.data.keys().hasOnly(['expoPushToken', 'rics'])
        && (
          request.resource.data.expoPushToken == null
          || (
            request.resource.data.expoPushToken is string
            && request.resource.data.expoPushToken.size() <= 256
            && request.resource.data.expoPushToken.matches('^(Expo|Exponent)PushToken\\[[A-Za-z0-9_-]+\\]$')
          )
        )
        && request.resource.data.rics is list
        && request.resource.data.rics.size() <= 100;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
